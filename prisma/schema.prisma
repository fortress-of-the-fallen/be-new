generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
}

generator dbml {
  provider = "prisma-dbml-generator"
  output   = "./schema.dbml"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid()) @map("_id")
  name          String?
  username      String?   @unique
  email         String?   @unique
  password      String?
  role          String[]
  maxSession    Int       @default(5)
  max_game_user Int       @default(3)
  isDeleted     Boolean   @default(false)
  isLocked      Boolean   @default(false)
  sessions      Session[]
  characters    Character[]

  @@map("users")
}

model Session {
  id        String   @id @map("_id")
  user      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  userAgent String?
  ipAddress String?
  isDeleted Boolean  @default(false)
  isLocked  Boolean  @default(false)
  account   User     @relation(fields: [user], references: [id])

  @@index([user])
  @@map("sessions")
}

model Character {
  id             String   @id @map("_id")
  character_name String
  race           String
  gender         String
  userId         String
  isDeleted      Boolean  @default(false)
  isLocked       Boolean  @default(false)
  user           User     @relation(fields: [userId], references: [id])
  appearance     CharacterAppearance?
  stats          CharacterStats?

  @@index([userId])
  @@map("characters")
}

model CharacterAppearance {
  id         String    @id @default(uuid()) @map("_id")
  characterId String   @unique
  hair       String
  beard      String
  eye        String
  hairColor  String
  beardColor String
  eyeColor   String
  character  Character @relation(fields: [characterId], references: [id])

  @@map("character_appearances")
}

model CharacterStats {
  id            String    @id @default(uuid()) @map("_id")
  /// FK character (1-1)
  characterId    String   @unique
  /// Base Attribute: Strength
  str           Int
  /// Base Attribute: Dexterity
  dex           Int
  /// Base Attribute: Constitution
  con           Int
  /// Base Attribute: Intelligence
  int           Int
  /// Base Attribute: Wisdom
  wis           Int
  /// Base Attribute: Charisma
  cha           Int
  /// Stat points chưa phân bổ
  unspentPoints Int       @default(0)
  /// Derived: Max HP
  hp            Int
  /// Derived: Max MP
  mp            Int
  /// Derived: Physical Attack
  patk          Int
  /// Derived: Physical Defense
  datk          Int
  /// Derived: Magic Attack
  matk          Int
  /// Derived: Magic Defense
  mdef          Int
  /// Derived: Speed
  spd           Int
  /// Derived: Critical Rate
  crit          Int
  /// Derived: Accuracy
  acc           Int
  /// Derived: Evasion
  eva           Int
  /// Version công thức tính derived stats
  formulaVersion Int      @default(1)
  updatedAt     DateTime  @updatedAt
  character     Character @relation(fields: [characterId], references: [id])

  @@map("character_stats")
}

model Backup {
  id        String   @id @default(uuid()) @map("_id")
  backUpType String
  filePath  String
  createAt  DateTime @default(now())
  isDeleted Boolean  @default(false)
  isLocked  Boolean  @default(false)

  @@index([backUpType, createAt])
  @@map("backups")
}
