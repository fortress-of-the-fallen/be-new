erDiagram
  "users" {
    String id PK "default: uuid()"
    String name
    String username
    String email
    String password
    String role
    Int maxSession  "default: 5"
    Int max_game_user  "default: 3"
    Boolean isDeleted  "default: false"
    Boolean isLocked  "default: false"
  }
  "sessions" {
    String id PK
    String user FK
    DateTime createdAt  "default: now()"
    DateTime expiresAt
    Boolean isRevoked  "default: false"
    String userAgent
    String ipAddress
    Boolean isDeleted  "default: false"
    Boolean isLocked  "default: false"
  }
  "characters" {
    String id PK
    String character_name
    String race
    String gender
    String userId FK
    Boolean isDeleted  "default: false"
    Boolean isLocked  "default: false"
  }
  "character_appearances" {
    String id PK "default: uuid()"
    String characterId FK
    String hair
    String beard
    String eye
    String hairColor
    String beardColor
    String eyeColor
  }
  "character_stats" {
    String id PK "default: uuid()"
    String characterId FK "FK character (1-1)"
    Int str  "Base Attribute: Strength"
    Int dex  "Base Attribute: Dexterity"
    Int con  "Base Attribute: Constitution"
    Int int  "Base Attribute: Intelligence"
    Int wis  "Base Attribute: Wisdom"
    Int cha  "Base Attribute: Charisma"
    Int unspentPoints  "default: 0 | Stat points chưa phân bổ"
    Int hp  "Derived: Max HP"
    Int mp  "Derived: Max MP"
    Int patk  "Derived: Physical Attack"
    Int datk  "Derived: Physical Defense"
    Int matk  "Derived: Magic Attack"
    Int mdef  "Derived: Magic Defense"
    Int spd  "Derived: Speed"
    Int crit  "Derived: Critical Rate"
    Int acc  "Derived: Accuracy"
    Int eva  "Derived: Evasion"
    Int formulaVersion  "default: 1 | Version công thức tính derived stats"
    DateTime updatedAt
  }
  "backups" {
    String id PK "default: uuid()"
    String backUpType
    String filePath
    DateTime createAt  "default: now()"
    Boolean isDeleted  "default: false"
    Boolean isLocked  "default: false"
  }
  "users" ||--o{ "sessions" : "account"
  "users" ||--o{ "characters" : "user"
  "characters" ||--o| "character_appearances" : "character"
  "characters" ||--o| "character_stats" : "character"