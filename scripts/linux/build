#!/bin/bash
set -euo pipefail

TOKEN_FILE="${HOME}/.docker_token"
IMAGE_NAME="${IMAGE_NAME:-trkhang4444/fotf}"
IMAGE_TAG="${IMAGE_TAG:-1.0.0-be_staging}"
DOCKER_CONFIG_TMP="$(mktemp -d)"

cleanup() {
  rm -rf "${DOCKER_CONFIG_TMP}"
}
trap cleanup EXIT

if [[ -n "${DOCKER_TOKEN:-}" ]]; then
  token="${DOCKER_TOKEN}"
elif [[ -f "${TOKEN_FILE}" ]]; then
  token="$(tr -d '\r\n' < "${TOKEN_FILE}")"
else
  echo "Missing Docker token. Set DOCKER_TOKEN or create ${TOKEN_FILE}." >&2
  exit 1
fi

if [[ -z "${token}" ]]; then
  echo "Docker token is empty." >&2
  exit 1
fi

echo "Building ${IMAGE_NAME}:${IMAGE_TAG}"
docker build -t "${IMAGE_NAME}:${IMAGE_TAG}" .

auth="$(printf 'trkhang4444:%s' "${token}" | base64 | tr -d '\n')"
cat > "${DOCKER_CONFIG_TMP}/config.json" <<EOF
{
  "auths": {
    "https://index.docker.io/v1/": {
      "auth": "${auth}"
    }
  }
}
EOF

echo "Pushing ${IMAGE_NAME}:${IMAGE_TAG}"
docker --config "${DOCKER_CONFIG_TMP}" push "${IMAGE_NAME}:${IMAGE_TAG}"
